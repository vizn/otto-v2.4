{
    "target": "esp32s3",
    "builds": [
        {
            "name": "otto-robot-v1",
            "sdkconfig_append": [
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
                "CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y",
                "CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH=\"certs\"",
                "CONFIG_OTA_URL=\"https://xiaozhi.zillionairetravel.com/xiaozhi/ota/\"",
                "CONFIG_OTA_URL_LAN=\"http://192.168.199.162:8003/xiaozhi/ota/\"",
                "# CONFIG_USE_AFE_WAKE_WORD is not set",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "# CONFIG_SR_MN_EN_NONE is not set",
                "CONFIG_SR_MN_EN_MULTINET6_QUANT=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"OK EMO\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"OK EMO\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20"
            ]
        }
    ]
}
